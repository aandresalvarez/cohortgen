# Copy to .env and fill values or rely on ADC

# Required for LLMs
OPENAI_API_KEY="sk-..."

# Optional: BigQuery auth (if not using ADC)
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service_account.json"

# Optional: BigQuery project (used for dry runs)
# BIGQUERY_PROJECT_ID="my-gcp-project"

# OMOP dataset (project.dataset). Defaults to CMS synthetic public dataset.
# OMOP_DATASET_ID="bigquery-public-data.cms_synthetic_patient_data_omop"

# BigQuery location/region (default US)
# BIGQUERY_LOCATION="US"

