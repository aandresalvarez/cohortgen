# OMOP Cohort Workflow - Environment Variables Example
# Copy this file to .env and fill in your actual values

# ============================================================================
# Required Credentials
# ============================================================================

# OpenAI API Key (Required for all AI agents)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...your-key-here...

# ============================================================================
# Optional Credentials (for BigQuery)
# ============================================================================

# Google Cloud Project ID (Optional - for BigQuery SQL validation)
# Get from: https://console.cloud.google.com/
GOOGLE_CLOUD_PROJECT=your-project-id

# BigQuery Project ID (Optional - defaults to GOOGLE_CLOUD_PROJECT)
# Only needed if your BigQuery project differs from GOOGLE_CLOUD_PROJECT
# BIGQUERY_PROJECT_ID=your-bigquery-project-id

# OMOP CDM Dataset ID (Optional - required for Stage 3 SQL validation & Stage 4 analytics)
# Format: project.dataset or just dataset (will use BIGQUERY_PROJECT_ID)
# Default: bigquery-public-data.cms_synthetic_patient_data_omop (public demo dataset)
# 
# IMPORTANT: The public demo dataset has limited tables (no measurement table)
# For production use, set this to your own OMOP CDM dataset:
# OMOP_DATASET_ID=your-project.your_omop_dataset
#
# Example:
# OMOP_DATASET_ID=alvaro-169413.my_omop_cdm

# BigQuery Location (Optional - defaults to US)
# BIGQUERY_LOCATION=US

# Path to Google Cloud service account key (Optional - alternative to gcloud auth)
# Create from: https://console.cloud.google.com/iam-admin/serviceaccounts
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ============================================================================
# Notes
# ============================================================================

# 1. Never commit this file with real values to Git!
# 2. The workflow works without BigQuery credentials (SQL validation skipped)
# 3. For local development, you can use: gcloud auth application-default login
# 4. See CREDENTIALS_SETUP.md for detailed setup instructions
